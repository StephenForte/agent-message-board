{
  "name": "agent-message-board",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/lib/server.ts --dev",
    "start": "tsx src/lib/server.ts",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate && tsx scripts/db-append-custom.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx scripts/db-check.ts"
  },
  "dependencies": {
    "@next/env": "^16.4.5",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
