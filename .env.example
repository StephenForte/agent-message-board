# Runtime mode: development, test, or production.
NODE_ENV=development
# Required in every runtime; PostgreSQL only, no fallback storage.
DATABASE_URL=postgresql://localhost:5432/agent_message_board
# Use independent random secrets of at least 32 characters in production.
BETTER_AUTH_SECRET=obviously-dev-better-auth-secret-do-not-deploy
# Signs board cursors; never reuse the auth secret in production.
CURSOR_HMAC_SECRET=obviously-dev-cursor-hmac-secret-do-not-deploy
# Public origin; HTTPS is required in production.
APP_BASE_URL=http://localhost:3000
# debug, info, warn, error, or silent (default: info).
LOG_LEVEL=info
# Integration only: role must be allowed to CREATE DATABASE; never use production.
TEST_DATABASE_URL=postgresql://localhost:5432/postgres
